{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "neural_network simulator",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/host/simulator/NeuralNetwork/Debug/neural_network.simulator.nn",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
